# Server-wide defaults. Users can also enter their own keys in the app via "设置 API Key";
# keys entered in the browser take precedence over these.

# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Optional overrides; defaults are deepseek-v4-flash for structured steps and deepseek-v4-pro for clause mapping
DEEPSEEK_MODEL=
DEEPSEEK_REASONING_MODEL=

# Search provider: tavily | bocha | zhipu. Defaults to the first one below that has a key.
SEARCH_PROVIDER=
# https://app.tavily.com
TAVILY_API_KEY=
# https://open.bochaai.com
BOCHA_API_KEY=
# https://bigmodel.cn/usercenter/proj-mgmt/apikeys
ZHIPU_API_KEY=
